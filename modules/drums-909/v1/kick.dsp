declare name "909 Kick";
declare version "0.1.0-experiment";
declare author "curlcomplex; selected MIT Plaits formulas by Emilie Gillet";
declare description "Pitch-swept oscillator and transistor-VCA formula, 60ms plateau, separately adjustable transient; reference comparison pending; one note per instance.";
import("stdfaust.lib");
u=library("drums909.lib");
gate=button("gate[curlop:input]");
freq=hslider("freq[unit:Hz][scale:log][curlop:input]",53,25,180,.001);
velocity=hslider("velocity[curlop:input]",1,0,1,.001);
accent=hslider("accent[curlop:input]",0,0,1,.001);
decay=hslider("decay[unit:s][col:0][row:0]",1.0,0.06,3.0,.001);
pitchAmount=hslider("pitchAmount[col:1][row:0]",0.595,0,1,.001);
pitchDecay=hslider("pitchDecay[unit:s][col:2][row:0]",0.025,0.002,0.15,.001);
attack=hslider("attack[col:3][row:0]",0.22,0,1,.001):u.sm;
tone=hslider("tone[col:0][row:1]",0.55,0,1,.001):u.sm;
drive=hslider("drive[col:1][row:1]",0.13,0,1,.001):u.sm;
level=hslider("level[col:2][row:1]",0.85,0,1,.001):u.sm;
h=gate>gate';
f=u.lat(h,freq);d=u.lat(h,decay);v=u.lat(h,velocity);a=u.lat(h,accent);
pa=u.lat(h,pitchAmount);pd=u.lat(h,pitchDecay);
fp=u.pitchEnvelope(h,f,pa*7,pd);
p=u.phase(h,fp);
e=u.env(h,d,.060,.00022);
body=-u.transistorVCA(u.sine(p),e);
transient=(no.noise:fi.highpass(1,900):fi.lowpass(1,6500))*u.env(h,.025,0,.00008)*attack*.45;
raw=(body+transient):fi.lowpass(1,min(.43*ma.SR,650*pow(24,tone)));
process=u.finish(raw,v,a,level,drive);
