declare name "909 Clap";
declare version "0.1.0-experiment";
declare author "curlcomplex; selected MIT Plaits formulas by Emilie Gillet";
declare description "Clustered noise attacks and a separately mixed diffuse tail; no pitched snare body; reference comparison pending; one note per instance.";
import("stdfaust.lib");
u=library("drums909.lib");
gate=button("gate[curlop:input]");
freq=hslider("freq[unit:Hz][scale:log][curlop:input]",1400,600,3200,.001);
velocity=hslider("velocity[curlop:input]",1,0,1,.001);
accent=hslider("accent[curlop:input]",0,0,1,.001);
decay=hslider("decay[unit:s][col:0][row:0]",0.22,0.03,1.0,.001);
spacing=hslider("spacing[unit:s][col:1][row:0]",0.0105,0.003,0.03,.001);
tail=hslider("tail[col:2][row:0]",0.45,0,1,.001):u.sm;
tone=hslider("tone[col:3][row:0]",0.5,0,1,.001):u.sm;
drive=hslider("drive[col:0][row:1]",0.13,0,1,.001):u.sm;
level=hslider("level[col:1][row:1]",0.95,0,1,.001):u.sm;
h=gate>gate';
f=u.lat(h,freq);d=u.lat(h,decay);v=u.lat(h,velocity);a=u.lat(h,accent);
t=u.age(h)/ma.SR;burstGap=u.lat(h,spacing);
burst(at)=float(t>=at)*float(t<at+.008)*exp(0-max(0,t-at)/.0020)*(1-exp(0-max(0,t-at)/.0001));
attacks=burst(0)+.82*burst(burstGap)+.75*burst(2*burstGap)+burst(3*burstGap);
tailEnv=float(t>=3*burstGap)*u.fall(t-3*burstGap,d)*(1-exp(0-max(0,t-3*burstGap)/.0006));
filtered=no.noise:fi.resonbp(min(.35*ma.SR,f*pow(1.8,tone-.5)),.8,1):fi.highpass(1,400+1400*tone);
raw=filtered*(attacks*2.3+tailEnv*tail*.95)*u.seen(h);
process=u.finish(raw,v,a,level,drive);
