// Diagnostic resource spike, not a 909 sample/instrument. No resource assets bundled.
import("stdfaust.lib");
u=library("drums909.lib");
// Table argument is a waveform primitive; source sample-rate and root Hz explicit.
play(wf,sourceRate,rootHz,gate,freq,velocity,chokeGate)=audio with {
 n=wf:(_,!);k=chokeGate>chokeGate';h=(gate>gate')*(1-k);
 f=u.lat(h,freq);v=u.lat(h,velocity);
 inc=max(.0001,min(16,f/rootHz))*sourceRate/ma.SR;
 // Onset-latched pitch permits exact elapsed-frame addressing: no accumulated
 // fractional phase drift or extra endpoint sample from repeated additions.
 pos=min(n+1,u.age(h)*inc);
 valid=u.seen(h)*float(pos<n);
 i=int(min(n-1,max(0,floor(pos))));j=min(n-1,i+1);alpha=pos-floor(pos);
 a=wf,i:rdtable;b=wf,j:rdtable;
 audio=(a+(b-a)*alpha)*valid*v*u.chokeGain(h,k);
};
