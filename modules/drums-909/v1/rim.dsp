declare name "909 Rim";
declare version "0.1.0-experiment";
declare author "curlcomplex; selected MIT Plaits formulas by Emilie Gillet";
declare description "Three short resonant modes and an independently controlled edge; uncalibrated 909 rim study; reference comparison pending; one note per instance.";
import("stdfaust.lib");
u=library("drums909.lib");
gate=button("gate[curlop:input]");
freq=hslider("freq[unit:Hz][scale:log][curlop:input]",480,180,1300,.001);
velocity=hslider("velocity[curlop:input]",1,0,1,.001);
accent=hslider("accent[curlop:input]",0,0,1,.001);
decay=hslider("decay[unit:s][col:0][row:0]",0.07,0.015,0.6,.001);
tone=hslider("tone[col:1][row:0]",0.55,0,1,.001):u.sm;
snap=hslider("snap[col:2][row:0]",0.3,0,1,.001):u.sm;
drive=hslider("drive[col:3][row:0]",0.12,0,1,.001):u.sm;
level=hslider("level[col:0][row:1]",0.85,0,1,.001):u.sm;
h=gate>gate';
f=u.lat(h,freq);d=u.lat(h,decay);v=u.lat(h,velocity);a=u.lat(h,accent);
r1=h:u.ring(f,d);r2=h:u.ring(f*2.04,d*.55);r3=h:u.ring(f*3.54,d*.28);
tick=(no.noise:fi.highpass(1,2300))*u.env(h,.009,0,.00006)*snap*.4;
raw=r1*(.7-.5*tone)+r2*.5+r3*(.08+.5*tone)+tick;
process=u.finish(raw,v,a,level,drive);
