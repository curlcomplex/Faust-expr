declare name "909 High Tom";
declare version "0.1.0-experiment";
declare author "curlcomplex; selected MIT Plaits formulas by Emilie Gillet";
declare description "909-oriented swept tonal tom with independently controlled attack-noise and body balance; authored model hypothesis; reference comparison pending; one note per instance.";
import("stdfaust.lib");
u=library("drums909.lib");
gate=button("gate[curlop:input]");
freq=hslider("freq[unit:Hz][scale:log][curlop:input]",210,90,480,.001);
velocity=hslider("velocity[curlop:input]",1,0,1,.001);
accent=hslider("accent[curlop:input]",0,0,1,.001);
decay=hslider("decay[unit:s][col:0][row:0]",0.34,0.05,2.0,.001);
bend=hslider("bend[col:1][row:0]",0.28,0,1,.001);
tone=hslider("tone[col:2][row:0]",0.5,0,1,.001):u.sm;
noise=hslider("noise[col:3][row:0]",0.1,0,1,.001):u.sm;
drive=hslider("drive[col:0][row:1]",0.08,0,1,.001):u.sm;
level=hslider("level[col:1][row:1]",0.8,0,1,.001):u.sm;
h=gate>gate';
f=u.lat(h,freq);d=u.lat(h,decay);v=u.lat(h,velocity);a=u.lat(h,accent);
b=u.lat(h,bend);
fp=u.pitchEnvelope(h,f,.65*b,.018);
p=u.phase(h,fp);q=u.phase(h,fp*1.58);
fund=u.sine(p)*u.env(h,d,0,.00022);
overtone=u.sine(q)*u.env(h,d*.27,0,.00012);
impact=(no.noise:fi.lowpass(1,1600+5000*tone))*u.env(h,.07+d*.13,0,.00010);
raw=fund*(.9-.25*tone)+overtone*(.08+.42*tone)+impact*noise*.4;
process=u.finish(raw,v,a,level,drive);
