declare name "909 Snare";
declare version "0.1.0-experiment";
declare author "curlcomplex; selected MIT Plaits formulas by Emilie Gillet";
declare description "Plaits-derived 1.47 dual-mode snare with separately held noise envelope; oscillator coupling remains a fidelity follow-up; reference comparison pending; one note per instance.";
import("stdfaust.lib");
u=library("drums909.lib");
gate=button("gate[curlop:input]");
freq=hslider("freq[unit:Hz][scale:log][curlop:input]",180,90,420,.001);
velocity=hslider("velocity[curlop:input]",1,0,1,.001);
accent=hslider("accent[curlop:input]",0,0,1,.001);
decay=hslider("decay[unit:s][col:0][row:0]",0.36,0.035,1.4,.001);
snappy=hslider("snappy[col:1][row:0]",0.65,0,1,.001):u.sm;
noiseDecay=hslider("noiseDecay[unit:s][col:2][row:0]",0.24,0.025,1.5,.001);
bend=hslider("bend[col:3][row:0]",0.13,0,1,.001);
tone=hslider("tone[col:0][row:1]",0.5,0,1,.001):u.sm;
drive=hslider("drive[col:1][row:1]",0.08,0,1,.001):u.sm;
level=hslider("level[col:2][row:1]",0.75,0,1,.001):u.sm;
h=gate>gate';
f=u.lat(h,freq);d=u.lat(h,decay);v=u.lat(h,velocity);a=u.lat(h,accent);
b=u.lat(h,bend);nd=u.lat(h,noiseDecay);
fp=u.pitchEnvelope(h,f,4*b*b,.007);
p1=u.phase(h,fp);p2=u.phase(h,fp*1.47);
body=(.60*u.snareSine(p1)+.25*u.snareSine(p2)-.1)*u.env(h,d,0,.0003):fi.lowpass(1,f*3);
wire=no.noise:fi.lowpass(2,min(.4*ma.SR,f*(20+20*tone))):fi.highpass(1,min(.25*ma.SR,f*(5+8*tone)));
wireEnv=u.env(h,nd,.040+.030*min(1,d),.00018);
raw=body*sqrt(max(0,1-snappy))+.95*wire*wireEnv*sqrt(max(0,snappy));
process=u.finish(raw,v,a,level,drive);
