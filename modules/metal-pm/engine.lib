// Independent electronic metallic-percussion study. Not Elektron source or recovered ratios.
import("stdfaust.lib");
pitch=hslider("pitch_hz",420,70,3000,.001);
color=hslider("color",.45,0,1,.001);
shape=hslider("shape",.52,0,1,.001);
sweep=hslider("sweep",.22,0,1,.001);
contour=hslider("contour",.5,0,1,.001);
decay=hslider("decay",.46,0,1,.001);
punch=hslider("punch",.3,0,1,.001);
drive=hslider("drive",.08,0,1,.001);
choke=checkbox("choke");
gate=button("gate");velocity=hslider("velocity",1,0,1,.001);
hit=gate>gate'; latched(x)=ba.sAndH(hit,x); vel=latched(velocity);
age=(+(1):min(40*ma.SR):*(1-hit))~_; t=age/ma.SR;
f0=latched(pitch); co=latched(color); sh=latched(shape); sw=latched(sweep); ct=latched(contour); de=latched(decay); pu=latched(punch); dr=latched(drive); ch=latched(choke);
// Ratios intentionally traverse harmonic-ish to increasingly inharmonic regions.
r1=1.0; r2=1.47+1.24*co; r3=2.11+2.73*co*co; r4=3.03+4.62*co; r5=4.17+6.81*co*co; r6=5.43+9.37*co;
pitchTau=.0025+.045*(1-pu)*(1-pu); f=f0*(1+(pow(2,2.5*sw)-1)*exp(-t/pitchTau));
modTau=.004*pow(70,ct); modEnv=.04*(1-ct)+.96*exp(-t/modTau);
phase(hz)=os.hs_phasor(1,hz,hit);
o6=sin(2*ma.PI*phase(f*r6));
o5=sin(2*ma.PI*(phase(f*r5)+o6*(.02+.14*sh)*modEnv));
o4=sin(2*ma.PI*(phase(f*r4)+o5*(.02+.17*sh)*modEnv));
o3=sin(2*ma.PI*(phase(f*r3)+o4*(.025+.19*sh)*modEnv));
o2=sin(2*ma.PI*(phase(f*r2)+o3*(.03+.22*sh)*modEnv));
o1=sin(2*ma.PI*(phase(f*r1)+o2*(.035+.25*sh)*modEnv));
// Crossfade sparse/dense readouts of the same six-state network.
sparse=.68*o1+.2*o3+.12*o5; dense=(o1+o2+o3+o4+o5+o6)/2.75;
body=(1-sh*sh)*sparse+sh*sh*dense;
bodyTau=.018*pow(120,de); amp=(1-exp(-t/(.00018+.0014*(1-pu))))*exp(-t/bodyTau);
// Optional choke is an explicit performance articulation, not a hidden decay rewrite.
releaseAge=(+(1):min(5*ma.SR):*(1-(gate'<:ch)))~_; rel=select2(ch,1,exp(-(releaseAge/ma.SR)/.008));
raw=body*amp*rel;
amount=dr*dr; driven=(1-amount)*raw+amount*ma.tanh(raw*(1+11*amount))/ma.tanh(1+11*amount);
finish=driven*.31*vel : fi.dcblockerat(12);
