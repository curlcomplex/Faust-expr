declare name "analog-classics-808-cymbal-study";
declare version "0.2.0-experiment";
declare category "Drums";
import("stdfaust.lib");
metal=hslider("metal",.96,0,1,.001);
tone=hslider("tone",.52,0,1,.001);
decay=hslider("decay",.68,0,1,.001);
shape=hslider("shape",.28,0,1,.001);
drive=hslider("drive",.05,0,1,.001);
freq=hslider("freq[unit:Hz][scale:log][curlop:input]",440,264,748,.001);
velocity=hslider("velocity[curlop:input]",1,0,1,.001);
gate=button("gate[curlop:input]");
hit=gate>gate';seen=max(hit)~_;
lat(x)=select2(seen,x,ba.sAndH(hit,x));
age=(+(1):min(30*ma.SR):*(1-hit))~_;t=age/ma.SR;
ratio=lat(freq)/440;sq(f)=os.polyblep_square(f);
s1=sq(205.3*ratio);s2=sq(304.4*ratio);s3=sq(369.6*ratio);
s4=sq(522.7*ratio);s5=sq(540.5*ratio);s6=sq(800*ratio);
summed=(s1+s2+s3+s4+s5+s6)/6;ringed=(s1*s2+s3*s5+s4*s6)/3;
bank=(1-.55*lat(shape))*summed+.55*lat(shape)*ringed;
excitation=lat(metal)*bank+(1-lat(metal))*.32*no.noise;
hp=4300+2600*lat(tone);center=6500+6500*lat(tone);
wide=excitation:fi.highpass(3,hp):fi.lowpass(1,min(.44*ma.SR,18500));
focus=excitation:fi.resonbp(min(.38*ma.SR,center),1.6,1):fi.highpass(2,hp*.7);
filtered=.58*wide+.72*focus;
tau1=.09*pow(7,lat(decay));tau2=.16*pow(10,lat(decay));
env=(.72*exp(-t/tau1)+.28*exp(-t/tau2))*(1-exp(-t/.00018))*seen;
raw=filtered*env;a=lat(drive)*lat(drive);
sat=(1-a)*raw+a*ma.tanh((1+10*a)*raw)/(1+2*a);
endFade=min(1,max(0,(12*tau2-t)/tau2));
process=(sat*.72*lat(velocity):fi.dcblockerat(20))*endFade;
