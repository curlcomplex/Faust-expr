declare name "analog-classics-808-snare-study";
declare version "0.2.0-experiment";
declare category "Drums";
import("stdfaust.lib");
tone=hslider("tone",.48,0,1,.001);
snappy=hslider("snappy",.62,0,1,.001);
decay=hslider("decay",.42,0,1,.001);
noiseColor=hslider("noise_color",.56,0,1,.001);
drive=hslider("drive",.05,0,1,.001);
freq=hslider("freq[unit:Hz][scale:log][curlop:input]",180,100,320,.001);
velocity=hslider("velocity[curlop:input]",1,0,1,.001);
gate=button("gate[curlop:input]");
hit=gate>gate'; seen=max(hit)~_;
lat(x)=select2(seen,x,ba.sAndH(hit,x));
age=(+(1):min(20*ma.SR):*(1-hit))~_; t=age/ma.SR;
vel=lat(velocity); f0=lat(freq);
bodyTau=.045*pow(8,lat(decay)); noiseTau=.025*pow(10,lat(decay));
phase1=os.hs_phasor(1,f0,hit);phase2=os.hs_phasor(1,f0*1.83,hit);
body=(.72*sin(2*ma.PI*phase1)+.28*sin(2*ma.PI*phase2))*exp(-t/bodyTau);
hp=900+4200*lat(noiseColor);lp=min(.44*ma.SR,6500+10000*lat(noiseColor));
noise=no.noise:fi.highpass(2,hp):fi.lowpass(1,lp);
wire=noise*exp(-t/noiseTau);
attack=exp(-t/.0018)*sin(2*ma.PI*os.hs_phasor(1,1900+1700*lat(tone),hit));
raw=(1-lat(snappy))*body+lat(snappy)*.92*wire+.11*attack;
a=lat(drive)*lat(drive);
sat=(1-a)*raw+a*ma.tanh((1+9*a)*raw)/(1+1.8*a);
endTau=max(bodyTau,noiseTau);endFade=min(1,max(0,(12*endTau-t)/endTau));
process=(sat*.52*vel*seen:fi.dcblockerat(15))*endFade;
