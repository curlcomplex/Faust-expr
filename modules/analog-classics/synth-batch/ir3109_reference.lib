// commit f6fe5b900f4cf84809686466e0a37de5edf008fd.
// Original author: Jean Pierre Cimalando. ISC licensed.
// This is a software/circuit reference component, not proof of a particular
// Roland unit's complete gain/resonance transfer.
import("stdfaust.lib");

// r is normalized 0..1. Four nonlinear TPT poles with nonlinear feedback.
vcf(f,r) = (+ : cascade) ~ feedback with {
  cascade = seq(i,4,poleEntry : tptPole(f));
  feedback = *(1.0) : tableTanh : *(-4.0*min(1,max(0,r)));
  poleEntry = +(ba.db2linear(-80.0)*no.noise) : tableTanh;
  tptPole(cf) = next with {
    next(x) = y letrec {
      'y = s+G*(x-s);
      's = s+G*(x-s)+G*(x-s);
    };
    g = min(ma.SR*.45,max(15,cf))*(ma.PI/ma.SR);
    G = g/(1.0+g);
  };
};

tableTanh(x) = value with {
  extent=3.0; points=128;
  expr=(ba.time/float(points-1)) : *(2.0*extent) : -(extent) : ma.tanh;
  read=max(0):min(points-1):rdtable(points,expr);
  pos=x:+(extent):*((points-1)*0.5/extent);
  ip=int(pos); mu=pos-ip;
  value=read(ip)+mu*(read(min(points-1,1+ip))-read(ip));
};
