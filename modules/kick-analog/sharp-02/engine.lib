// Independent BD-Sharp-inspired behavioural study, not Elektron circuit code.
// Two mathematically equivalent Fourier evaluators: direct = reference;
// Clenshaw = optimization. No sample assets or waveform/table extraction.
import("stdfaust.lib");
pitch = hslider("pitch_hz",52,20,160,.001);
sweepTime = hslider("sweep_time",.45,0,1,.001);
sweep = hslider("sweep",.48,0,1,.001);
decay = hslider("decay",.52,0,1,.001);
wave = hslider("wave",0,0,11,1);
hold = hslider("hold",0,0,1,.001);
click = hslider("click",.15,0,1,.001);
drive = hslider("drive",.18,0,1,.001);
gate = button("gate");
velocity = hslider("velocity",1,0,1,.001);
hit = gate > gate';
seen = max(hit) ~ _;
latched(x) = ba.sAndH(hit,x);
vel = latched(velocity);
waveCode = int(latched(wave));
kind = int(waveCode/2);
freePhase = waveCode % 2;
// Gesture smoothing is sample-rate, not block-rate. Locks snap on an onset.
coef = exp(-1.0/(.003*ma.SR));
follow(x) = loop ~ _ with {
    loop(previous) = select2(hit, x*(1.0-coef)+previous*coef, x);
};
frequency = exp(follow(log(pitch)));
amount = latched(pow(2.0,4.0*sweep)-1.0);
pitchTau = latched(.003*pow(50.0,sweepTime));
bodyTau = latched(.02*pow(90.0,decay));
holdTime = latched(2.0*hold*hold);
driveNow = follow(drive);
age = (+(1.0) : min(60.0*ma.SR) : *(1.0-hit)) ~ _;
t = age/ma.SR;
f = frequency*(1.0+amount*exp(-t/max(.003,pitchTau)));
amp = (1.0-exp(-t/.0003))*exp((0.0-max(0.0,t-holdTime))/max(.02,bodyTau));
p = os.hs_phasor(1.0,f,hit*(1-freePhase));
theta = 2.0*ma.PI*p;
// Smoothly remove partials approaching Nyquist, rather than hard bins.
// The 16-harmonic authored waveforms themselves remain an approximation.
nyquistWeight(n) = min(1.0,max(0.0,(.47*ma.SR-n*f)/(.07*ma.SR)));
sawCoeff(n) = (2.0/ma.PI)*(1-2*((n+1)%2))/n;
triCoeff(n) = (8.0/(ma.PI*ma.PI))*(n%2)*(1-2*(int((n-1)/2)%2))/(n*n);
squareCoeff(n) = (4.0/ma.PI)*(n%2)/n;
// "Asymmetric" and "sinetooth" are independent authored approximations.
coeff(n) = nyquistWeight(n) * (
    (kind==0)*(n==1)
    +(kind==1)*(.80*(n==1)+.20*(n==2))
    +(kind==2)*triCoeff(n)
    +(kind==3)*(.65*(n==1)+.35*sawCoeff(n))
    +(kind==4)*sawCoeff(n)
    +(kind==5)*squareCoeff(n));
direct = par(i,16,coeff(i+1)*sin((i+1)*theta)) :> _;
// Clenshaw b[n]=a[n]+2*cos(theta)*b[n+1]-b[n+2].
// Static unrolling; bounded constant work, no solver or table allocation.
c = 2.0*cos(theta);
b17 = 0.0; b18 = 0.0;
b16 = coeff(16)+c*b17-b18;
b15 = coeff(15)+c*b16-b17;
b14 = coeff(14)+c*b15-b16;
b13 = coeff(13)+c*b14-b15;
b12 = coeff(12)+c*b13-b14;
b11 = coeff(11)+c*b12-b13;
b10 = coeff(10)+c*b11-b12;
b9 = coeff(9)+c*b10-b11;
b8 = coeff(8)+c*b9-b10;
b7 = coeff(7)+c*b8-b9;
b6 = coeff(6)+c*b7-b8;
b5 = coeff(5)+c*b6-b7;
b4 = coeff(4)+c*b5-b6;
b3 = coeff(3)+c*b4-b5;
b2 = coeff(2)+c*b3-b4;
b1 = coeff(1)+c*b2-b3;
clenshaw = sin(theta)*b1;
shape(x) = (1.0-driveNow*driveNow)*x
    +driveNow*driveNow*ma.tanh(x*(1.0+15.0*driveNow*driveNow))
        /ma.tanh(1.0+15.0*driveNow*driveNow);
// Stable fixed-state output path; no moving IIR coefficients on locks.
// Short noise/tone exciter, explicitly independent of waveform and decay.
cp = os.hs_phasor(1.0,4200.0,hit);
exciter = latched(click)*latched(click)*exp(-t/.0015)
    *(0.55*no.noise+0.45*sin(2.0*ma.PI*cp));
finish(x) = (amp*shape(x)+.18*exciter)*.42*vel*seen : fi.dcblockerat(8);
