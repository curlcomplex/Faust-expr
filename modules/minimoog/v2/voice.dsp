declare name "Analog Classics Mini Voice";
declare version "0.2.0-reference-candidate";
declare description "Single-note Model-D-inspired candidate with permissive nonlinear ladder reference; not hardware approved";
import("stdfaust.lib");
cs=library("common.lib");
md=library("modeld_ladder_reference.lib");
gate=button("gate[curlop:input]");
freq=hslider("freq[unit:Hz][scale:log][curlop:input]",110,20,8000,.01);
velocity=hslider("velocity[curlop:input]",1,0,1,.001);
slide=checkbox("slide[curlop:input]");
glideTime=hslider("glideTime[unit:s]",.09,0,1,.001);
osc1=hslider("osc1",.8,0,1,.001):cs.sm(.005);
osc2=hslider("osc2",.65,0,1,.001):cs.sm(.005);
osc3=hslider("osc3",.4,0,1,.001):cs.sm(.005);
detune2=hslider("detune2[unit:st]",.07,-7,7,.001):cs.sm(.005);
detune3=hslider("detune3[unit:st]",-12,-24,12,.001):cs.sm(.005);
noise=hslider("noise",0,0,1,.001):cs.sm(.005);
cutoff=hslider("cutoff[unit:Hz][scale:log]",800,30,16000,1):log:cs.sm(.005):exp;
emphasis=hslider("emphasis",2.2,.707,12,.001):cs.sm(.005);
contour=hslider("contour",.52,0,1,.001):cs.sm(.005);
drive=hslider("drive",.22,0,1,.001):cs.sm(.005);
attack=hslider("attack[unit:s][scale:log]",.008,.001,2,.001):cs.sm(.005);
decay=hslider("decay[unit:s][scale:log]",.28,.005,4,.001):cs.sm(.005);
sustain=hslider("sustain",.72,0,1,.001):cs.sm(.005);
release=hslider("release[unit:s][scale:log]",.3,.005,5,.001):cs.sm(.005);
filterDecay=hslider("filterDecay[unit:s][scale:log]",.2,.005,4,.001):cs.sm(.005);
level=hslider("level",.60,0,1,.001):cs.sm(.005);
state(f0,g0,v0,s0)=audio,pitchHz,env,hit with {
 pitchHz=cs.pitch(f0,g0,s0,glideTime); hit=(g0>0)>(g0'>0);
 f1=cs.clip(5,ma.SR*.20,pitchHz); f2=cs.clip(5,ma.SR*.20,pitchHz*pow(2,detune2/12)); f3=cs.clip(5,ma.SR*.20,pitchHz*pow(2,detune3/12));
 raw=.50*(os.polyblep_saw(f1)*osc1+os.polyblep_saw(f2)*osc2+os.polyblep_square(f3)*osc3+no.noise*noise*.12);
 env=en.adsr(max(.001,attack),max(.005,decay),sustain,max(.005,release),g0>0);
 fenv=en.adsr(max(.001,attack),max(.005,filterDecay),.2*sustain,max(.005,release),g0>0);
 pre=ma.tanh(raw*(1+5*drive)); fc=cs.clip(25,ma.SR*.40,cutoff*pow(2,5*contour*fenv));
 // Preserve the public emphasis range; map it monotonically to normalized ladder feedback.
 rnorm=cs.clip(0,.98,(emphasis-.707)/(12-.707));
 filtered=pre:md.vcf(fc,rnorm);
 audio=(ma.tanh(filtered):fi.dcblockerat(20))*env*cs.vel(g0,v0)*level*.7;
};
voice(f0,g0,v0,s0)=state(f0,g0,v0,s0):(_,!,!,!);
diagnostics(f0,g0,v0,s0)=state(f0,g0,v0,s0):(!,_,_,_);
process=voice(freq,gate,velocity,slide);
