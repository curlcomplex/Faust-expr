// Diagnostic: same clustered attack/body, dedicated diffuse tail removed.
import("stdfaust.lib");
pitch=hslider("pitch_hz",520,220,1800,.001);spacing=hslider("spacing",.42,0,1,.001);punch=hslider("punch",.52,0,1,.001);decay=hslider("decay",.48,0,1,.001);color=hslider("color",.58,0,1,.001);body=hslider("body",.24,0,1,.001);drive=hslider("drive",.12,0,1,.001);gate=button("gate");velocity=hslider("velocity",1,0,1,.001);
hit=gate>gate';seen=max(hit)~_;latched(x)=ba.sAndH(hit,x);p0=latched(pitch);sp=latched(spacing);pu=latched(punch);de=latched(decay);co=latched(color);bo=latched(body);dr=latched(drive);vel=latched(velocity);age=(+(1):min(30*ma.SR):*(1-hit))~_;t=age/ma.SR;gap=.0015+.0155*sp*sp;d1=gap;d2=gap*2.05;d3=gap*3.35;ct=.0007+.0055*(1-pu)*(1-pu);bt=.012*pow(26,de)*(.55+.75*bo);e0=min(1,max(0,t*ma.SR))*exp((0-t)/ct);e1=min(1,max(0,(t-d1)*ma.SR))*exp((0-max(0,t-d1))/ct);e2=min(1,max(0,(t-d2)*ma.SR))*exp((0-max(0,t-d2))/ct);e3=min(1,max(0,(t-d3)*ma.SR))*exp((0-max(0,t-d3))/ct);n=no.noise;dark=n:fi.highpass(1,450):fi.lowpass(1,4300);mid=n:fi.highpass(1,900):fi.lowpass(1,8200);bright=n:fi.highpass(1,1800):fi.lowpass(1,15000);ns=dark*(1-co)*(1-co)+mid*(1-abs(2*co-1))+bright*co*co;cluster=ns*(e0+.86*e1+.73*e2+.58*e3);ph1=os.hs_phasor(1,p0,hit);ph2=os.hs_phasor(1,p0*(1.52+.42*co),hit);benv=(1-exp((0-t)/.00045))*exp((0-t)/bt);tonal=benv*(.72*sin(2*ma.PI*ph1)+.28*sin(2*ma.PI*ph2));raw=(1-.42*bo)*(cluster*.19+exp((0-t)/(.00025+.0012*(1-pu)))*ns*.035*pu)+tonal*(.25*bo);a=dr*dr;process=((1-a)*raw+a*ma.tanh(raw*(1+12*a))/ma.tanh(1+12*a))*.72*vel*seen:fi.dcblockerat(10);
