// Independent CP-Vintage-inspired clap architecture; not recovered Elektron source.
import("stdfaust.lib");

pitch = hslider("pitch_hz", 210, 70, 900, .001);
spacing = hslider("spacing", .44, 0, 1, .001);
punch = hslider("punch", .42, 0, 1, .001);
decay = hslider("decay", .50, 0, 1, .001);
balance = hslider("balance", .42, 0, 1, .001);
body = hslider("body", .38, 0, 1, .001);
bodyEnvCtl = hslider("body_env", .46, 0, 1, .001);
drive = hslider("drive", .10, 0, 1, .001);
gate = button("gate");
velocity = hslider("velocity", 1, 0, 1, .001);

hit = gate > gate';
seen = max(hit) ~ _;
latched(x) = ba.sAndH(hit,x);
f0=latched(pitch); sp=latched(spacing); pn=latched(punch); dc=latched(decay);
bal=latched(balance); bd=latched(body); be=latched(bodyEnvCtl); dr=latched(drive); vel=latched(velocity);
age=(+(1.0):min(30.0*ma.SR):*(1.0-hit))~_; t=age/ma.SR;

// Four separately windowed clap impulses. SPACING controls separation and window duration;
// its upper half progressively adds a high-frequency crunch path.
gap=.0015+.0200*sp*sp;
clTau=.0007+.0048*(1.0-sp)+.0020*(1.0-pn);
d0=max(0.0,t); g0=min(1.0,max(0.0,t*ma.SR)); w0=g0*exp(-d0/clTau);
x1=t-gap; d1=max(0.0,x1); g1=min(1.0,max(0.0,x1*ma.SR)); w1=g1*exp(-d1/clTau);
x2=t-2.07*gap; d2=max(0.0,x2); g2=min(1.0,max(0.0,x2*ma.SR)); w2=g2*exp(-d2/clTau);
x3=t-3.24*gap; d3=max(0.0,x3); g3=min(1.0,max(0.0,x3*ma.SR)); w3=g3*exp(-d3/clTau);
clusterEnv=w0+.88*w1+.70*w2+.52*w3;

noise=no.noise;
dark=noise:fi.highpass(1,450):fi.lowpass(1,4200);
mid=noise:fi.highpass(1,1100):fi.lowpass(1,9000);
bright=noise:fi.highpass(1,2600):fi.lowpass(1,16000);
color=.40*dark+.45*mid+.15*bright;
crunchAmt=max(0.0,2.0*sp-1.0);
crunch=(noise:fi.highpass(1,4800):fi.lowpass(1,18500));
cluster=(1.0-.55*crunchAmt)*color*clusterEnv + .55*crunchAmt*crunch*clusterEnv;

// Diffuse tail remains independent of early sub-attacks.
tailTau=.022*pow(48.0,dc);
tailAttack=1.0-exp(-t/.0035);
tail=tailAttack*exp(-t/tailTau)*(.55*dark+.45*mid);
noiseVoice=.64*cluster + .44*tail;

// Authored FM body. BODY coordinates ratio/index/feedback-like phase complexity;
// BODY_ENV controls only its amplitude/modulation falloff.
phase=os.hs_phasor(1.0,f0,hit);
theta=2.0*ma.PI*phase;
ratio=1.20+5.30*bd*bd;
modPhase=ratio*theta;
modulator=sin(modPhase + 2.2*bd*bd*sin(.5*theta));
bodyTau=.010*pow(75.0,be);
bodyEnvelope=(1.0-exp(-t/.0008))*exp(-t/bodyTau);
index=.12+4.8*bd*bd;
bodyVoice=bodyEnvelope*sin(theta + index*bodyEnvelope*modulator);

singleNoise=.64*(color*w0)+.44*tail;
noTailNoise=.64*cluster;
noiseGain=sqrt(max(0.0,1.0-bal));
bodyGain=sqrt(max(0.0,bal));
mixed=noiseGain*noiseVoice + bodyGain*bodyVoice;
singleMixed=noiseGain*singleNoise + bodyGain*bodyVoice;
noTailMixed=noiseGain*noTailNoise + bodyGain*bodyVoice;
noBodyMixed=noiseGain*noiseVoice;

// Punch and Drive are identical across the full and controlled ablation paths.
punchEnv=exp(-t/(.004+.014*(1.0-pn)));
punchAmt=.42*pn*pn;
a=dr*dr;
post(x)=withPunch:withDrive with {
  emphasized = x*(1.0+.72*pn*punchEnv);
  withPunch = (1.0-punchAmt)*emphasized + punchAmt*ma.tanh(emphasized*(1.0+5.0*pn))/ma.tanh(1.0+5.0*pn);
  withDrive = (1.0-a)*withPunch+a*ma.tanh(withPunch*(1.0+10.0*a))/ma.tanh(1.0+10.0*a);
};
full=post(mixed);
singleFull=post(singleMixed);
noTailFull=post(noTailMixed);
noBodyFull=post(noBodyMixed);
finish(x)=x*.40*vel*seen:fi.dcblockerat(10);
