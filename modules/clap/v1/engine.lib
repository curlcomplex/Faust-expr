// Independent electronic clap voice. Behavioral reference: clustered clap triggers + diffuse tail.
// No proprietary circuit/source extraction.
import("stdfaust.lib");

pitch = hslider("pitch_hz", 520, 220, 1800, .001);
spacing = hslider("spacing", .42, 0, 1, .001);
punch = hslider("punch", .52, 0, 1, .001);
decay = hslider("decay", .48, 0, 1, .001);
color = hslider("color", .58, 0, 1, .001);
body = hslider("body", .24, 0, 1, .001);
drive = hslider("drive", .12, 0, 1, .001);
gate = button("gate");
velocity = hslider("velocity", 1, 0, 1, .001);

hit = gate > gate';
seen = max(hit) ~ _;
latched(x) = ba.sAndH(hit, x);
pitchValue = latched(pitch);
spacingValue = latched(spacing);
punchValue = latched(punch);
decayValue = latched(decay);
colorValue = latched(color);
bodyValue = latched(body);
driveValue = latched(drive);
velocityValue = latched(velocity);

age = (+(1.0) : min(30.0*ma.SR) : *(1.0-hit)) ~ _;
t = age / ma.SR;
gap = .0015 + .0155*spacingValue*spacingValue;
offset1 = gap; offset2 = gap*2.05; offset3 = gap*3.35;
clusterTau = .0007 + .0055*(1.0-punchValue)*(1.0-punchValue);
tailTau = .025*pow(70.0, decayValue);
bodyTau = .012*pow(26.0, decayValue) * (.55 + .75*bodyValue);

event0 = min(1.0,max(0.0,t*ma.SR))*exp((0.0-t)/clusterTau);
event1 = min(1.0,max(0.0,(t-offset1)*ma.SR))*exp((0.0-max(0.0,t-offset1))/clusterTau);
event2 = min(1.0,max(0.0,(t-offset2)*ma.SR))*exp((0.0-max(0.0,t-offset2))/clusterTau);
event3 = min(1.0,max(0.0,(t-offset3)*ma.SR))*exp((0.0-max(0.0,t-offset3))/clusterTau);
tailStart = offset3 + .0015;
tailEnv = min(1.0,max(0.0,(t-tailStart)*ma.SR))*exp((0.0-max(0.0,t-tailStart))/tailTau);
attackClick = exp((0.0-t)/(.00025 + .0012*(1.0-punchValue)));

noiseSource = no.noise;
darkNoise = noiseSource : fi.highpass(1, 450.0) : fi.lowpass(1, 4300.0);
midNoise = noiseSource : fi.highpass(1, 900.0) : fi.lowpass(1, 8200.0);
brightNoise = noiseSource : fi.highpass(1, 1800.0) : fi.lowpass(1, 15000.0);
noiseShape = darkNoise*(1.0-colorValue)*(1.0-colorValue) + midNoise*(1.0-abs(2.0*colorValue-1.0)) + brightNoise*colorValue*colorValue;
cluster = noiseShape*(event0 + .86*event1 + .73*event2 + .58*event3);
diffuse = noiseShape*tailEnv*(.22 + .78*(1.0-punchValue*.45));

phase1 = os.hs_phasor(1.0, pitchValue, hit);
phase2 = os.hs_phasor(1.0, pitchValue*(1.52 + .42*colorValue), hit);
bodyEnv = (1.0-exp((0.0-t)/.00045))*exp((0.0-t)/bodyTau);
tonal = bodyEnv*(.72*sin(2.0*ma.PI*phase1) + .28*sin(2.0*ma.PI*phase2));
raw = (1.0-.42*bodyValue)*(cluster*.19 + diffuse*.23 + attackClick*noiseShape*.035*punchValue) + tonal*(.25*bodyValue);
driveMix = driveValue*driveValue;
shaped = (1.0-driveMix)*raw + driveMix*ma.tanh(raw*(1.0+12.0*driveMix))/ma.tanh(1.0+12.0*driveMix);
process = shaped*.72*velocityValue*seen : fi.dcblockerat(10);
